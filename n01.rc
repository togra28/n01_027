/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU_MAIN MENU DISCARDABLE 
BEGIN
    POPUP "&Game"
    BEGIN
        MENUITEM "&New Game...",                ID_MENUITEM_NEW_GAME
        MENUITEM SEPARATOR
        MENUITEM "N&ew Schedule...",            ID_MENUITEM_NEW_SCHEDULE
        MENUITEM "&Modify Schedule...",         ID_MENUITEM_SET_SCHEDULE
        MENUITEM SEPARATOR
        MENUITEM "Game &History...",            ID_MENUITEM_GAME_HISTORY
        MENUITEM SEPARATOR
        MENUITEM "&Option...",                  ID_MENUITEM_OPTION
        MENUITEM "Auto &Save",                  ID_MENUITEM_AUTO_SAVE
        MENUITEM "&Check-Out Mode",             ID_MENUITEM_CHECK_OUT_MODE
        MENUITEM SEPARATOR
        MENUITEM "n01 On&line",                 ID_MENUITEM_ONLINE
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_MENUITEM_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Name",                       ID_MENUITEM_SHOW_NAME
        MENUITEM "&Player Information",         ID_MENUITEM_SHOW_PLAYER
        MENUITEM "&Left Score",                 ID_MENUITEM_SHOW_LEFT
        MENUITEM "Function &Key",               ID_MENUITEM_SHOW_GUIDE
        MENUITEM SEPARATOR
        POPUP "Left Score &Size"
        BEGIN
            MENUITEM "&Larger",                     ID_MENUITEM_FONT_L
            MENUITEM "&Medium",                     ID_MENUITEM_FONT_M
            MENUITEM "&Smaller",                    ID_MENUITEM_FONT_S
        END
        MENUITEM "&Full Screen",                ID_MENUITEM_FULL_SCREEN
        MENUITEM SEPARATOR
        MENUITEM "&Index of Darts",             ID_MENUITEM_SHOW_DARTSCOUNT
    END
    POPUP "&Score"
    BEGIN
        MENUITEM "&1st dart",                   ID_MENUITEM_FINISH_ONE
        MENUITEM "&2nd dart",                   ID_MENUITEM_FINISH_TWO
        MENUITEM "&3rd dart",                   ID_MENUITEM_FINISH_THREE
        MENUITEM SEPARATOR
        MENUITEM "&Middle for Diddle...",       ID_MENUITEM_MIDDLE
        MENUITEM SEPARATOR
        POPUP "T&emplate"
        BEGIN
            MENUITEM "(Nothing)",                   ID_MENUITEM_NOTHING
            , GRAYED
        END
        MENUITEM "Input &Left Score",           ID_MENUITEM_SCORE_LEFT
        MENUITEM SEPARATOR
        MENUITEM "&Previous Leg",               ID_MENUITEM_PREV_LEG
        MENUITEM "E&xchange Scores",            ID_MENUITEM_SCORE_SWAP
        MENUITEM "&Clear Scores",               ID_MENUITEM_SCORE_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "&Dart Out Shots...",          ID_MENUITEM_ARRANGE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",                   ID_MENUITEM_ABOUT
    END
END


