                    BS_AUTOCHECKBOX | WS_TABSTOP,15,40,45,10
    EDITTEXT        IDC_EDIT_ROUND,74,39,35,12,ES_RIGHT | ES_AUTOHSCROLL | 
                    ES_NUMBER
    CONTROL         "Spin2",IDC_SPIN_ROUND,"msctls_updown32",UDS_SETBUDDYINT | 
                    UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | 
                    UDS_NOTHOUSANDS,114,40,11,15
    GROUPBOX        "Legs",IDC_STATIC,5,65,225,45
